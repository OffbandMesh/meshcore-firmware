tatic const uint8_t A3  = PIN_A3;\nstatic const uint8_t A4  = PIN_A4;\nstatic const uint8_t A5  = PIN_A5;\n\n#define ADC_RESOLUTION          (12)\n\n// Other pins\n#define PIN_NFC1                (30)\n#define PIN_NFC2                (31)\n\n// Serial interfaces\n#define PIN_SERIAL1_RX          (7)\n#define PIN_SERIAL1_TX          (6)\n\n// SPI Interfaces\n#define SPI_INTERFACES_COUNT    (2)\n\n#define PIN_SPI_MISO            (9)\n#define PIN_SPI_MOSI            (10)\n#define PIN_SPI_SCK             (8)\n\n#define PIN_SPI1_MISO           (25)\n#define PIN_SPI1_MOSI           (26)\n#define PIN_SPI1_SCK            (29)\n\n// Lora SPI is on SPI0\n#define  P_LORA_SCLK            PIN_SPI_SCK\n#define  P_LORA_MISO            PIN_SPI_MISO\n#define  P_LORA_MOSI            PIN_SPI_MOSI\n\n// Wire Interfaces\n#define WIRE_INTERFACES_COUNT   (1)\n\n// #define PIN_WIRE_SDA            (17) // 4 and 5 are used for the sx1262 !\n// #define PIN_WIRE_SCL            (16) // use WIRE1_SDA\n\nstatic const uint8_t SDA = PIN_WIRE_SDA;\nstatic const uint8_t SCL = PIN_WIRE_SCL;\n\n//#define PIN_WIRE1_SDA           (17)\n//#define PIN_WIRE1_SCL           (16)\n#define PIN_LSM6DS3TR_C_POWER   (15)\n#define PIN_LSM6DS3TR_C_INT1    (18)\n\n// PDM Interfaces\n#define PIN_PDM_PWR\t            (19)\n#define PIN_PDM_CLK\t            (20)\n#define PIN_PDM_DIN\t            (21)\n\n// QSPI Pins\n#define PIN_QSPI_SCK            (24)\n#define PIN_QSPI_CS             (25)\n#define PIN_QSPI_IO0            (26)\n#define PIN_QSPI_IO1            (27)\n#define PIN_QSPI_IO2            (28)\n#define PIN_QSPI_IO3            (29)\n\n// On-board QSPI Flash\n#define EXTERNAL_FLASH_DEVICES  (P25Q16H)\n#define EXTERNAL_FLASH_USE_QSPI\n\n#ifdef __cplusplus\n}\n#endif\n\n/*----------------------------------------------------------------------------\n *        Arduino objects - C++ only\n *----------------------------------------------------------------------------*/\n\n#endif\n\n\n=== C:\\Dev\\meshcore-firmware-photon-nrf52\\variants\\meshsmith_photon_nrf52\\variant.cpp ===\n#include \"variant.h\"\n#include \"wiring_constants.h\"\n#include \"wiring_digital.h\"\n#include \"nrf.h\"\n\nconst uint32_t g_ADigitalPinMap[] =\n{\n    // D0 .. D10\n     2, // D0  is P0.02 (A0)\n     3, // D1  is P0.03 (A1)\n    28, // D2  is P0.28 (A2)\n    29, // D3  is P0.29 (A3)\n     4, // D4  is P0.04 (A4,SDA)\n     5, // D5  is P0.05 (A5,SCL)\n    43, // D6  is P1.11 (TX)\n    44, // D7  is P1.12 (RX)\n    45, // D8  is P1.13 (SCK)\n    46, // D9  is P1.14 (MISO)\n    47, // D10 is P1.15 (MOSI)\n\n    // LEDs\n    26, // D11 is P0.26 (LED RED)\n     6, // D12 is P0.06 (LED BLUE)\n    30, // D13 is P0.30 (LED GREEN)\n    14, // D14 is P0.14 (READ_BAT)\n\n    // LSM6DS3TR\n    40, // D15 is P1.08 (6D_PWR)\n    27, // D16 is P0.27 (6D_I2C_SCL)\n     7, // D17 is P0.07 (6D_I2C_SDA)\n    11, // D18 is P0.11 (6D_INT1)\n\n    // MIC\n    42, // D19 is P1.10 (MIC_PWR)\n    32, // D20 is P1.00 (PDM_CLK)\n    16, // D21 is P0.16 (PDM_DATA)\n\n    // BQ25100\n    13, // D22 is P0.13 (HICHG)\n    17, // D23 is P0.17 (~CHG)\n\n    //\n    21, // D24 is P0.21 (QSPI_SCK)\n    25, // D25 is P0.25 (QSPI_CSN)\n    20, // D26 is P0.20 (QSPI_SIO_0 DI)\n    24, // D27 is P0.24 (QSPI_SIO_1 DO)\n    22, // D28 is P0.22 (QSPI_SIO_2 WP)\n    23, // D29 is P0.23 (QSPI_SIO_3 HOLD)\n\n    // NFC\n     9, // D30 is P0.09 (NFC1)\n    10, // D31 is P0.10 (NFC2)\n\n    // VBAT\n    31, // D32 is P0.31 (VBAT)\n};\n\nvoid initVariant()\n{\n    // Disable reading of the BAT voltage.\n    // https://wiki.seeedstudio.com/XIAO_BLE#q3-what-are-the-considerations-when-using-xiao-nrf52840-sense-for-battery-charging\n    pinMode(VBAT_ENABLE, OUTPUT);\n    //digitalWrite(VBAT_ENABLE, HIGH); \n    // This was taken from Seeed github butis not coherent with the doc, \n    // VBAT_ENABLE should be kept to LOW to protect P0.14, (1500/500)*(4.2-3.3)+3.3 = 3.9V > 3.6V\n    // This induces a 3mA current in the resistors :( but it's better than burning the nrf\n    digitalWrite(VBAT_ENABLE, LOW);\n\n    // Low charging current (50mA)\n    // https://wiki.seeedstudio.com/XIAO_BLE#battery-charging-current\n    //pinMode(PIN_CHARGING_CURRENT, INPUT);\n\n    // High charging current (100mA)\n    pinMode(PIN_CHARGING_CURRENT, OUTPUT);\n    digitalWrite(PIN_CHARGING_CURRENT, LOW);\n\n    pinMode(PIN_QSPI_CS, OUTPUT);\n    digitalWrite(PIN_QSPI_CS, HIGH);\n\n    pinMode(LED_RED, OUTPUT);\n    digitalWrite(LED_RED, HIGH);\n    pinMode(LED_GREEN, OUTPUT);\n    digitalWrite(LED_GREEN, HIGH);\n    pinMode(LED_BLUE, OUTPUT);\n    digitalWrite(LED_BLUE, HIGH);\n}\n\n\n=== C:\\Dev\\meshcore-firmware-photon-nrf52\\variants\\meshsmith_photon_nrf52\\platformio.ini ===\n[meshsmith_photon_nrf52]\nextends = nrf52_base\nboard = seeed-xiao-afruitnrf52-nrf52840\nboard_build.ldscript = boards/nrf52840_s140_v7.ld\nbuild_flags = ${nrf52_base.build_flags}\n  ${sensor_base.build_flags}\n  -D NRF52_PLATFORM -D XIAO_NRF52\n  -I lib/nrf52/s140_nrf52_7.3.0_API/include\n  -I lib/nrf52/s140_nrf52_7.3.0_API/include/nrf52\n  -I variants/meshsmith_photon_nrf52\n  -I src/helpers/nrf52\n  -D P_LORA_TX_LED=11\n  -D DISPLAY_CLASS=NullDisplayDriver\n   -D USE_SX1262\n   -D RADIO_CLASS=CustomSX1262\n  -D WRAPPER_CLASS=CustomSX1262Wrapper\n  -D P_LORA_DIO_1=D0\n  -D P_LORA_RESET=D1\n  -D P_LORA_BUSY=D2\n  -D P_LORA_NSS=D3\n  -D SX126X_RXEN=RADIOLIB_NC\n  -D SX126X_TXEN=RADIOLIB_NC\n  -D SX126X_DIO2_AS_RF_SWITCH=1\n  -D SX126X_DIO3_TCXO_VOLTAGE=1.8\n  -D SX126X_CURRENT_LIMIT=140\n  -D SX126X_RX_BOOSTED_GAIN=1\n  -D PIN_WIRE_SCL=5\n  -D PIN_WIRE_SDA=4\n  -D PIN_GPS_TX=PIN_SERIAL1_RX\n  -D PIN_GPS_RX=PIN_SERIAL1_TX\n  -D GPS_BAUD_RATE=115200\n  -D PHOTON_HAS_BATT_CHARGE_RATE=1\nlib_deps = ${nrf52_base.lib_deps}\n  ${sensor_base.lib_deps}\n\n\n\n[meshsmith_photon_nrf52_e22p_30dbm]\nextends = meshsmith_photon_nrf52\n; limit txpower to 20dBm on E22-900M30S. Anything higher will\n; cause distortion in the PA output. 20dBm in -> 30dBm out\nbuild_flags =\n  ${meshsmith_photon_nrf52.build_flags}\n  -D MANUFACTURER_STRING='\"Meshsmith Photon nRF52-E22P-30dBm (Xiao nRF52)\"'\n  -D LORA_TX_POWER=20\nbuild_src_filter = ${meshsmith_photon_nrf52.build_src_filter}\n  +<helpers/*.cpp>\n  +<helpers/sensors>\n  +<helpers/ui/NullDisplayDriver.cpp>\n  +<../variants/meshsmith_photon_nrf52>\n\n\n;;; abstracted firmware roles\n\n[meshsmith_photon_nrf52_companion_radio_ble]\nextends = meshsmith_photon_nrf52\nboard_build.ldscript = boards/nrf52840_s140_v7_extrafs.ld\nboard_upload.maximum_size = 708608\nbuild_flags =\n  ${meshsmith_photon_nrf52.build_flags}\n  -D MAX_CONTACTS=350\n  -D MAX_GROUP_CHANNELS=40\n  -D BLE_PIN_CODE=123456\n  -D OFFLINE_QUEUE_SIZE=256\n  -I examples/companion_radio/ui-new\n  -D QSPIFLASH=1\n;  -D BLE_DEBUG_LOGGING=1\n;  -D MESH_PACKET_LOGGING=1\n;  -D MESH_DEBUG=1\nbuild_src_filter = ${meshsmith_photon_nrf52.build_src_filter}\n  +<helpers/nrf52/SerialBLEInterface.cpp>\n  +<../examples/companion_radio/*.cpp>\n  +<../examples/companion_radio/ui-new/*.cpp>\nlib_deps =\n  ${meshsmith_photon_nrf52.lib_deps}\n  densaugeo/base64 @ ~1.4.0\n\n[meshsmith_photon_nrf52_companion_radio_usb]\nextends = meshsmith_photon_nrf52\nboard_build.ldscript = boards/nrf52840_s140_v7_extrafs.ld\nboard_upload.maximum_size = 708608\nbuild_flags =\n  ${meshsmith_photon_nrf52.build_flags}\n  -D MAX_CONTACTS=350\n  -D MAX_GROUP_CHANNELS=40\n  -I examples/companion_radio/ui-new\n  -D QSPIFLASH=1\n;  -D MESH_PACKET_LOGGING=1\n;  -D MESH_DEBUG=1\nbuild_src_filter = ${meshsmith_photon_nrf52.build_src_filter}\n  +<helpers/nrf52/SerialBLEInterface.cpp>\n  +<../examples/companion_radio/*.cpp>\n  +<../examples/companion_radio/ui-new/*.cpp>\nlib_deps =\n  ${meshsmith_photon_nrf52.lib_deps}\n  densaugeo/base64 @ ~1.4.0\n\n[meshsmith_photon_nrf52_repeater]\nextends = meshsmith_photon_nrf52\nbuild_flags =\n  ${meshsmith_photon_nrf52.build_flags}\n  -D ADVERT_NAME='\"Meshsmith Photon Repeater\"'\n  -D ADVERT_LAT=0.0\n  -D ADVERT_LON=0.0\n  -D ADMIN_PASSWORD='\"password\"'\n  -D MAX_NEIGHBOURS=50\n  -D MESHSMITH_PHOTON_GPS_TIME=0\n  -D MESHSMITH_PHOTON_LOW_ACTIVITY_GPS=0\n  -D GPS_SERIAL_SUSPEND_WHEN_STOPPED=0\n;  -D MESH_PACKET_LOGGING=1\n  -D MESH_DEBUG=1\nbuild_src_filter = ${meshsmith_photon_nrf52.build_src_filter}\n  +<helpers/ui/NullDisplayDriver.cpp>\n  +<../examples/simple_repeater/*.cpp>\n\n[meshsmith_photon_nrf52_room_server]\nextends = meshsmith_photon_nrf52\nbuild_flags =\n  ${meshsmith_photon_nrf52.build_flags}\n  -D ADVERT_NAME='\"Meshsmith Photon Room\"'\n  -D ADVERT_LAT=0.0\n  -D ADVERT_LON=0.0\n  -D ADMIN_PASSWORD='\"password\"'\n  -D ROOM_PASSWORD='\"hello\"'\n;  -D MESH_PACKET_LOGGING=1\n;  -D MESH_DEBUG=1\nbuild_src_filter = ${meshsmith_photon_nrf52.build_src_filter}\n  +<helpers/ui/NullDisplayDriver.cpp>\n  +<../examples/simple_room_server/*.cpp>\n\n\n;Meshsmith\n[env:meshsmith_photon_nrf52_e22p_30dbm_companion_radio_ble]\nextends =\n   meshsmith_photon_nrf52_e22p_30dbm\n   meshsmith_photon_nrf52_companion_radio_ble\nbuild_flags =\n   ${meshsmith_photon_nrf52_companion_radio_ble.build_flags}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_flags}\nbuild_src_filter =\n   ${meshsmith_photon_nrf52_companion_radio_ble.build_src_filter}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_src_filter}\n\n[env:meshsmith_photon_nrf52_e22p_30dbm_companion_radio_usb]\nextends =\n   meshsmith_photon_nrf52_e22p_30dbm\n   meshsmith_photon_nrf52_companion_radio_usb\nbuild_flags =\n   ${meshsmith_photon_nrf52_companion_radio_usb.build_flags}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_flags}\nbuild_src_filter =\n   ${meshsmith_photon_nrf52_companion_radio_usb.build_src_filter}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_src_filter}\n\n[env:meshsmith_photon_nrf52_e22p_30dbm_repeater]\nextends =\n   meshsmith_photon_nrf52_e22p_30dbm\n   meshsmith_photon_nrf52_repeater\nbuild_flags =\n   ${meshsmith_photon_nrf52_repeater.build_flags}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_flags}\nbuild_src_filter =\n   ${meshsmith_photon_nrf52_repeater.build_src_filter}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_src_filter}\n\n[env:meshsmith_photon_nrf52_e22p_30dbm_room_server]\nextends =\n   meshsmith_photon_nrf52_e22p_30dbm\n   meshsmith_photon_nrf52_room_server\nbuild_flags =\n   ${meshsmith_photon_nrf52_room_server.build_flags}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_flags}\nbuild_src_filter =\n   ${meshsmith_photon_nrf52_room_server.build_src_filter}\n   ${meshsmith_photon_nrf52_e22p_30dbm.build_src_filter}\n\n\n",
  "response": "## Summary\nThe port compiles cleanly against the base and produces valid firmware images, but this is deceptive. The vendored code contains a **blocker-level power management flaw** that will cause significant battery drain, rendering the device unsuitable for its intended use case. Furthermore, it introduces a **major bricking risk** due to a non-standard firmware memory layout that requires a specific, undocumented bootloader. The claim of \"zero base edits\" is correct, but the vendored code itself is not safe to merge as-is.\n\n## Issues\n- **[BLOCKER] Power** \u2014 The variant initialization code permanently enables the nRF52's ADC battery voltage divider, causing a constant ~3mA power drain. The board definition, however, completely ignores this ADC circuit and reads battery voltage from an I2C fuel gauge (MAX17048). This means the firmware is actively draining the battery for a measurement circuit it never uses. This is a critical flaw for any battery-powered device.\n  - **Evidence**: `variant.cpp`, `initVariant()`\n    ```cpp\n    void initVariant()\n    {\n        // Disable reading of the BAT voltage.\n        // ...\n        // This was taken from Seeed github butis not coherent with the doc, \n        // ...\n        // This induces a 3mA current in the resistors :( but it's better than burning the nrf\n        digitalWrite(VBAT_ENABLE, LOW); // Enables the voltage divider\n    }\n    ```\n    Meanwhile, `MeshsmithPhotonNRFBoard.h` reads voltage via I2C, not the ADC:\n    ```cpp\n    uint16_t getBattMilliVolts() override {\n      // MAX17048 VCELL uses 78.125uV LSB units.\n      uint16_t vcell = 0;\n      if (readFuelGaugeRegister(FUEL_GAUGE_VCELL_REGISTER, vcell)) { // Reads from I2C\n        return (uint32_t)(vcell * 5) / 64;\n      }\n      return 0;\n    }\n    ```\n  - **Fix**: The `digitalWrite(VBAT_ENABLE, LOW);` line and related `pinMode` call in `initVariant()` should be removed. The voltage divider circuit is not used and should remain disabled.\n\n- **[MAJOR] Firmware** \u2014 The firmware is built with a non-standard application start offset of `0x27000`. Most nRF52840 UF2 bootloaders for the S140 v7 SoftDevice expect the application to start at `0x26000`. Flashing a `.uf2` file built for `0x27000` onto a device with a standard `0x26000` bootloader will fail at best, and at worst, will result in a soft-bricked device that cannot be recovered without an SWD programmer.\n  - **Evidence**: This can't be confirmed without seeing the linker script `boards/nrf52840_s140_v7.ld`, but the submitter's statement that \"UF2 builds at start `0x27000`\" is the primary evidence. This implies the `FLASH ORIGIN` in the linker script has been modified from the community standard.\n  - **Fix**: Either revert to the standard `0x26000` offset to maintain compatibility with standard bootloaders, or this port **must** be accompanied by the specific bootloader it was built for, along with explicit flashing instructions warning users that they must replace their existing bootloader. The risk of bricking user devices is too high otherwise.\n\n- **[MINOR] GPS** \u2014 The custom `PhotonGPSLocationProvider` relies on proprietary `$PAIR` NMEA sentences for power management. This is specific to certain modules (e.g., ATGM336H) and will fail silently on other common GPS modules like the u-blox series, meaning the GPS will not enter low-power modes as intended. This hardware-specific dependency is not documented.\n  - **Evidence**: `PhotonGPSLocationProvider.h`\n    ```cpp\n    void begin() override {\n      ...\n      sendSentence(\"$PAIR002\"); // Wake command\n      ...\n    }\n    void stop() override {\n      ...\n      sendSentence(\"$PAIR003\"); // Sleep command\n      ...\n    }\n    ```\n  - **Fix**: Add a comment to the header explaining the hardware dependency. Consider making this behavior configurable or falling back to a generic (no-op) power management scheme if these commands are not appropriate for all hardware configurations.\n\n- **[QUESTION] Code Clarity** \u2014 The custom `variant.cpp` appears to be a copy-paste from the Seeed XIAO nRF52840 *Sense* board, which has a different peripheral configuration. The handling of `VBAT_ENABLE` is one symptom. Does the Photon-1W board even have this ADC voltage divider circuit populated? If not, the `initVariant` code is not only wasteful but also manipulating an unconnected pin.\n  - **Evidence**: The code comments in `initVariant()` refer to the Seeed wiki and behavior specific to their dev board. The file also configures pins for an LSM6DS3TR IMU and a PDM microphone (`D15` through `D21`), which may not exist on the Photon-1W.\n  - **Fix**: Confirm the Photon-1W schematic. The variant files should be cleaned up to remove initialization code for hardware that is not present on the board.\n\n## Verdict\n**DO NOT MERGE.** The `[BLOCKER]` power drain issue makes the firmware unfit for its purpose. The `[MAJOR]` bricking risk from the non-standard memory layout is unacceptable without a bundled, documented bootloader update process. The vendored code was clearly not tailored for this specific hardware and carries significant, user-impacting flaws despite compiling without error."
}