p\n@@ -1,4 +1,5 @@\n #include \"EnvironmentSensorManager.h\"\n+#include <MeshLog.h>  // #411: route GPS status through the serial-capture sink\n \n #include <Wire.h>\n \n@@ -1089,14 +1090,16 @@ void EnvironmentSensorManager::loop() {\n     next_gps_update = millis() + (gps_update_interval_sec * 1000);\n   }\n \n-  // Offband (#149): periodic GPS-state line so the chain (enabled->detected->fix->\n-  // coords) is visible live on the serial console without a client. Self-throttled.\n+  // Offband (#149/#411): periodic GPS-state line (enabled->detected->fix->coords).\n+  // Routed through the serial-capture sink so it is captured for download AND\n+  // mirrored to the live console where serial is free -- all gated by the\n+  // client-settable caplog enable+level, never raw on a USB-serial companion line.\n   static uint32_t _gps_log_ms = 0;\n   if (millis() - _gps_log_ms >= 5000) {\n     _gps_log_ms = millis();\n     char _gps_b[160];\n     getGpsStatusText(_gps_b, sizeof(_gps_b));\n-    Serial.print(\"[GPS] \"); Serial.println(_gps_b);\n+    mesh_log_line(MLOG_DEBUG, \"[GPS] %s\\n\", _gps_b);\n   }\n   #endif\n   #if ENV_INCLUDE_BME680_BSEC\ndiff --git a/src/helpers/sensors/MicroNMEALocationProvider.h b/src/helpers/sensors/MicroNMEALocationProvider.h\nindex 464b0ae2..3b7fe255 100644\n--- a/src/helpers/sensors/MicroNMEALocationProvider.h\n+++ b/src/helpers/sensors/MicroNMEALocationProvider.h\n@@ -4,6 +4,7 @@\n #include <MicroNMEA.h>\n #include <RTClib.h>\n #include <helpers/RefCountedDigitalPin.h>\n+#include <MeshLog.h>  // #411: [GPSPARSE] routed through the serial-capture sink\n \n #ifndef GPS_EN\n     #ifdef PIN_GPS_EN\n@@ -200,14 +201,12 @@ public :\n         static long _gpsparse_t = 0;\n         if (millis() - _gpsparse_t >= 1000) {\n             _gpsparse_t = millis();\n-            Serial.print(\"[GPSPARSE] valid=\"); Serial.print(nmea.isValid() ? 1 : 0);\n-            Serial.print(\" y=\"); Serial.print(nmea.getYear());\n-            Serial.print(\" mo=\"); Serial.print(nmea.getMonth());\n-            Serial.print(\" d=\"); Serial.print(nmea.getDay());\n-            Serial.print(\" h=\"); Serial.print(nmea.getHour());\n-            Serial.print(\" mi=\"); Serial.print(nmea.getMinute());\n-            Serial.print(\" s=\"); Serial.print(nmea.getSecond());\n-            Serial.print(\" ts=\"); Serial.println((long)getTimestamp());\n+            // #411: route through the sink (captured + mirrored where serial is free).\n+            mesh_log_line(MLOG_DEBUG,\n+                \"[GPSPARSE] valid=%d y=%d mo=%d d=%d h=%d mi=%d s=%d ts=%ld\\n\",\n+                nmea.isValid() ? 1 : 0, (int)nmea.getYear(), (int)nmea.getMonth(),\n+                (int)nmea.getDay(), (int)nmea.getHour(), (int)nmea.getMinute(),\n+                (int)nmea.getSecond(), (long)getTimestamp());\n         }\n #endif\n     }\n\n\n",
  "response": "This is a sound and well-reasoned change. The implementation correctly addresses the design intent.\n\n1.  **Mirror Reentrancy (`mesh_log_line`)**:\n    *   `src/MeshLog.cpp:134`\n    *   **Severity**: Low/Acceptable.\n    *   `Serial.write` is correctly placed outside the lock to avoid blocking within a critical section. Concurrent calls from two tasks can result in interleaved output on the mirrored serial console (e.g., `[TASK1_PART1][TASK2_PART1][TASK1_PART2]...`). This is a cosmetic issue for a human-readable debug mirror and is acceptable. The primary capture mechanism (the ring buffer) remains correctly ordered and uncorrupted due to the lock. The protocol line is explicitly protected from this by `g_meshLogMirror` being false. This is the correct trade-off.\n\n2.  **`isConsoleSharedWithProtocol` Correctness**:\n    *   `src/helpers/ArduinoSerialInterface.h:40`\n    *   **Severity**: Sound.\n    *   The `_serial == &Serial` pointer comparison is a robust and correct way to determine if the interface is using the global `Serial` object on standard Arduino-core platforms (nRF52, ESP32, etc.). The `BaseSerialInterface` default of `false` is safe, correctly enabling the mirror for non-serial transports (like BLE) or dedicated UART bridges where the console is free.\n\n3.  **Macro Change (`MESH_DEBUG_PRINTLN`)**:\n    *   `src/MeshCore.h:32`\n    *   **Severity**: Sound.\n    *   This is an improvement. It unifies all debug output through the runtime `g_meshLogEnabled` flag, fulfilling the intent.\n        *   **No regression**: It fixes a potential double-print bug in the old `MESH_DEBUG` build where output could come from both the direct `Serial.printf` and the mirror.\n        *   **Hot-path cost**: The `if (g_meshLogEnabled)` guard ensures arguments are not evaluated when logging is disabled, maintaining performance.\n        *   The retirement of the compile-time serial branch is the explicit goal.\n\n4.  **GPS Routing Format Safety**:\n    *   `src/helpers/sensors/EnvironmentSensorManager.cpp:1098`\n    *   `src/helpers/sensors/MicroNMEALocationProvider.h:207`\n    *   **Severity**: Sound.\n    *   The implementation is safe from format-string vulnerabilities. In both cases, the format string is a constant literal. The variable data (`_gps_b`, GPS fields) is passed as arguments to format specifiers (`%s`, `%d`, `%ld`), not used as the format string itself. The types and casts in the `[GPSPARSE]` line are correct.\n\n5.  **Anything Missed**:\n    *   **Severity**: Sound.\n    *   The `g_meshLogMirror` default of `true` is a sensible \"debug is visible\" default for non-companion roles (repeater, observer). The logic in `companion_radio/main.cpp` correctly overrides this for the one case where it would be harmful. The assumption that `Serial` exists and is the debug console is standard and safe within this project's context. The use of `volatile` for the global flags is correct."
