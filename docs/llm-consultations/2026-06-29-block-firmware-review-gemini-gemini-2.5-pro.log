n // gates the WHOLE command -- every key, display included -- on WIFI_OBSERVER_SUPPORT\n // (in addition to FIRMWARE_VER_CODE >= 14). There is NO display-without-observer path.\n constexpr uint8_t OFFBAND_CAP_WIFI_OBSERVER = 0x01;  // bit 0: config backend (wifi_observer) compiled in\n+constexpr uint8_t OFFBAND_CAP_BLOCK         = 0x02;  // bit 1: user-block list (BlockStore) compiled in (#241)\n+\n+// Block-list sync (fork command 0xC2; companion-API only, NEVER on the mesh -- the\n+// block list is receive-side only and changes no forwarding/relay/advert path,\n+// contract \u00a711). Request sub-code in cmd_frame[1]; replies echo it in out_frame[1].\n+constexpr uint8_t CMD_OFFBAND_BLOCK       = 0xC2;  // request:  cmd_frame[0]\n+constexpr uint8_t RESP_CODE_OFFBAND_BLOCK = 0xC2;  // response: out_frame[0]\n+constexpr uint8_t OFFBAND_BLOCK_ADD    = 0x01;\n+constexpr uint8_t OFFBAND_BLOCK_REMOVE = 0x02;\n+constexpr uint8_t OFFBAND_BLOCK_LIST   = 0x03;\n+constexpr uint8_t OFFBAND_BLOCK_CLEAR  = 0x04;\n \n // ---------------------------------------------------------------------------\n // Key schema -- the firmware<->client contract surface\ndiff --git a/src/helpers/BlockStore.h b/src/helpers/BlockStore.h\nnew file mode 100644\nindex 00000000..d1161cdb\n--- /dev/null\n+++ b/src/helpers/BlockStore.h\n@@ -0,0 +1,81 @@\n+#pragma once\n+\n+#include <cstdint>\n+#include <cstring>\n+\n+// BlockStore -- a fixed-capacity set of blocked node public-key prefixes.\n+//\n+// This is the portable, firmware-side \"ignore list\" core for the Block/Ignore\n+// Users feature (Offband-only; see docs/architecture/2026-06-28-block-user-\n+// firmware-app-contract.md). It is deliberately dependency-free (no Arduino,\n+// no heap) so it compiles in the native googletest env AND on-device, and so\n+// its behavior is unit-testable in isolation. Persistence and the 0xC2 sync\n+// protocol live in MyMesh, not here -- this class is pure in-memory state.\n+//\n+// Keys are stored as raw BLOCK_KEY_SIZE-byte buffers (the identity pubkey, the\n+// real cryptographic identity -- see Identity.h). Lookup/compare is a constant-\n+// time-irrelevant linear memcmp scan; the capacity is small (32) so O(n) is fine.\n+\n+#ifndef MAX_BLOCKED_KEYS\n+  #define MAX_BLOCKED_KEYS 32\n+#endif\n+\n+#ifndef BLOCK_KEY_SIZE\n+  #define BLOCK_KEY_SIZE 32\n+#endif\n+\n+class BlockStore {\n+public:\n+  BlockStore() : _count(0) {}\n+\n+  int count() const { return _count; }\n+\n+  // Pointer to the i-th stored key (BLOCK_KEY_SIZE bytes). Caller must pass a\n+  // valid index in [0, count()); used by the 0xC2 LIST reply. Returns nullptr\n+  // for an out-of-range index rather than reading past the array.\n+  const uint8_t* keyAt(int i) const {\n+    if (i < 0 || i >= _count) return nullptr;\n+    return _keys[i];\n+  }\n+\n+  bool contains(const uint8_t* pubkey) const {\n+    return indexOf(pubkey) >= 0;\n+  }\n+\n+  // Add a key. Returns true if the key is present after the call (already\n+  // there -> dedup, count unchanged, still true). Returns false only when the\n+  // store is full and the key is not already present.\n+  bool add(const uint8_t* pubkey) {\n+    if (indexOf(pubkey) >= 0) return true;        // dedup\n+    if (_count >= MAX_BLOCKED_KEYS) return false; // full\n+    memcpy(_keys[_count], pubkey, BLOCK_KEY_SIZE);\n+    _count++;\n+    return true;\n+  }\n+\n+  // Remove a key. Returns true if it was present (and removed), false if not.\n+  // Swap-remove: the last entry fills the gap, so order is not preserved.\n+  bool remove(const uint8_t* pubkey) {\n+    int idx = indexOf(pubkey);\n+    if (idx < 0) return false;\n+    int last = _count - 1;\n+    if (idx != last) {\n+      memcpy(_keys[idx], _keys[last], BLOCK_KEY_SIZE);\n+    }\n+    _count--;\n+    return true;\n+  }\n+\n+  void clear() { _count = 0; }\n+\n+private:\n+  int indexOf(const uint8_t* pubkey) const {\n+    for (int i = 0; i < _count; i++) {\n+      if (memcmp(_keys[i], pubkey, BLOCK_KEY_SIZE) == 0) return i;\n+    }\n+    return -1;\n+  }\n+\n+  uint8_t _keys[MAX_BLOCKED_KEYS][BLOCK_KEY_SIZE];\n+  int _count;\n+};\ndiff --git a/test/test_block/test_block_store.cpp b/test/test_block/test_block_store.cpp\nnew file mode 100644\nindex 00000000..371da891\n--- /dev/null\n+++ b/test/test_block/test_block_store.cpp\n@@ -0,0 +1,59 @@\n+#include <gtest/gtest.h>\n+#include <cstring>\n+#include \"helpers/BlockStore.h\"\n+\n+static void mkKey(uint8_t* out, uint8_t seed) { memset(out, seed, BLOCK_KEY_SIZE); }\n+\n+TEST(BlockStore, AddContainsRemove) {\n+    BlockStore bs;\n+    uint8_t a[BLOCK_KEY_SIZE], b[BLOCK_KEY_SIZE];\n+    mkKey(a, 0xAA); mkKey(b, 0xBB);\n+\n+    EXPECT_EQ(bs.count(), 0);\n+    EXPECT_FALSE(bs.contains(a));\n+\n+    EXPECT_TRUE(bs.add(a));\n+    EXPECT_TRUE(bs.contains(a));\n+    EXPECT_FALSE(bs.contains(b));\n+    EXPECT_EQ(bs.count(), 1);\n+\n+    EXPECT_TRUE(bs.remove(a));\n+    EXPECT_FALSE(bs.contains(a));\n+    EXPECT_EQ(bs.count(), 0);\n+    EXPECT_FALSE(bs.remove(a));   // not present\n+}\n+\n+TEST(BlockStore, DedupAndCapacity) {\n+    BlockStore bs;\n+    uint8_t k[BLOCK_KEY_SIZE];\n+    mkKey(k, 0x01);\n+    EXPECT_TRUE(bs.add(k));\n+    EXPECT_TRUE(bs.add(k));        // dedup -> still true, count stays 1\n+    EXPECT_EQ(bs.count(), 1);\n+\n+    for (int i = 2; i <= MAX_BLOCKED_KEYS; i++) {\n+        uint8_t kk[BLOCK_KEY_SIZE]; mkKey(kk, (uint8_t)i); EXPECT_TRUE(bs.add(kk));\n+    }\n+    EXPECT_EQ(bs.count(), MAX_BLOCKED_KEYS);\n+\n+    uint8_t overflow[BLOCK_KEY_SIZE]; mkKey(overflow, 0xFF);\n+    EXPECT_FALSE(bs.add(overflow)); // full\n+    EXPECT_EQ(bs.count(), MAX_BLOCKED_KEYS);\n+}\n+\n+TEST(BlockStore, RemoveMiddleKeepsOthers) {\n+    BlockStore bs;\n+    uint8_t a[BLOCK_KEY_SIZE], b[BLOCK_KEY_SIZE], c[BLOCK_KEY_SIZE];\n+    mkKey(a, 1); mkKey(b, 2); mkKey(c, 3);\n+    bs.add(a); bs.add(b); bs.add(c);\n+    EXPECT_TRUE(bs.remove(b));\n+    EXPECT_EQ(bs.count(), 2);\n+    EXPECT_TRUE(bs.contains(a));\n+    EXPECT_TRUE(bs.contains(c));\n+    EXPECT_FALSE(bs.contains(b));\n+}\n+\n+int main(int argc, char **argv) {\n+    ::testing::InitGoogleTest(&argc, argv);\n+    return RUN_ALL_TESTS();\n+}\n\n\n",
  "response": "An adversarial review of the \"Block/Ignore Users \u2014 firmware half\" feature follows.\n\n## Overall Assessment\n\nThis is a well-designed and carefully implemented feature. The separation of the pure `BlockStore` data structure from the `MyMesh` protocol/persistence logic is clean and allows for effective unit testing. The implementation shows a good understanding of the firmware's main-loop architecture, particularly in the design of the non-blocking, streamed LIST response to avoid overflowing the serial send queue. The critical goal of preserving mesh interoperability by restricting the block to the final, local-delivery application layer has been successfully achieved.\n\nThe review found no BLOCKER or MAJOR defects. One MINOR correctness issue related to state cleanup on client disconnect was identified.\n\n---\n\n### **[MINOR]** Dangling stream state on client disconnect\n\n**File:** `MyMesh.h` (fix location)\n**Line:** (within `clearPendingReqs` method)\n**Severity:** MINOR\n\n**Defect:**\nThe `_blk_listing` flag, which indicates an in-progress `LIST` command response, is not reset when the companion client disconnects. If a client requests a block list and then disconnects before the stream completes, the `_blk_listing` flag will remain `true` indefinitely.\n\nWhile a subsequent `LIST` command from a new client would correctly restart the stream, if no such command is ever sent, the firmware will continue to check this dangling state flag in `checkSerialInterface()` on every main loop pass for the lifetime of the device, consuming a small but unnecessary number of cycles.\n\nThis pattern is inconsistent with how other request states are handled. For example, the contacts iterator state (`_iter_started`) is correctly reset in `clearPendingReqs()`, which is called when a new serial interface is attached (i.e., a new client connects). The new `_blk_listing` state should follow this established pattern for robust state management.\n\n**Fix:**\nReset the block list streaming state within the `clearPendingReqs()` method, alongside other client-session-specific flags.\n\n**Concrete fix in `MyMesh.h`:**\n```diff\n--- a/examples/companion_radio/MyMesh.h\n+++ b/examples/companion_radio/MyMesh.h\n@@ -268,6 +268,7 @@\n   void clearPendingReqs() {\n     pending_login = 0;\n     pending_status = 0;\n+    _blk_listing = false; // #241: clear any in-flight LIST stream on client disconnect/reconnect\n     if (sign_data) {\n       free(sign_data);\n       sign_data = NULL;\n```\n\n---\n\n## Other Focus Area Validations\n\nThe following areas were reviewed based on the focus questions and found to be implemented correctly, with no defects identified.\n\n*   **1. Interop & ACK Behavior:** The claim that dropping a message in `queueMessage` does not affect mesh-level ACKs or forwarding is **correct**. `queueMessage` is part of the application-level callback path (`onMessageRecv`), which is invoked by the routing layer *after* mesh-level responsibilities like ACKing and forwarding have already been handled. The change is confined to the local application delivery layer and poses no risk to mesh interoperability.\n*   **2. `queueMessage` Drop Safety:** The early return is safe. The `from.id.pub_key` is the correct user identifier. The `pkt` pointer is managed by the caller of `onMessageRecv`, so no memory leak is introduced. The drop correctly bypasses all local-delivery logic (UI notification, offline queueing, app push) as intended.\n*   **3. Persistence:** The `/blocks` file persistence mechanism is robust.\n    *   The new `DataStore::openWriteFile()` helper correctly reuses the existing platform-agnostic, truncating-write logic.\n    *   `saveBlocks` writes a well-formed file.\n    *   `loadBlocks` is safe against file corruption, correctly handling short reads and validating the number of keys against `MAX_BLOCKED_KEYS` to prevent buffer overflows.\n*   **4. 0xC2 Handler:** The command handler in `handleCmdFrame` correctly validates incoming frame lengths for `ADD` and `REMOVE` sub-commands, preventing reads past the end of the command buffer. All outgoing response frames are well within `MAX_FRAME_SIZE`, posing no risk of buffer overflow.\n*   **5. LIST Streaming State Machine:** The streaming logic is sound. It is resilient to re-entrant `LIST` commands (which restart the stream) and concurrent `ADD`/`REMOVE`/`CLEAR` operations. While concurrent modifications can result in a slightly inconsistent list being delivered in that one stream instance, this is a reasonable trade-off that prevents crashes or memory corruption, and the system is eventually consistent.\n*   **6. `BlockStore` Implementation:** The `BlockStore` class is correct. Its logic for add (with deduping), swap-remove, and bounds-checked access (`keyAt`) is sound and verified by the provided unit tests.\n*   **7. Versioning & Capability Bit:** Bumping `FIRMWARE_VER_CODE` to 15 and adding the `OFFBAND_CAP_BLOCK` bit is implemented in a backwards-compatible way. Older clients will ignore the new capability bit and will not trigger the new functionality."
}