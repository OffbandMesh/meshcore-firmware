#undef CMD1
#undef CMD2

  writeCommand(NV3001B_SLPOUT);
  delay(120);

  const uint8_t colmod = 0x05;                    // 16-bit RGB
  const uint8_t madctl = 0x00;                    // init default (rotation 0)
  writeCommandData(NV3001B_COLMOD, &colmod, 1);
