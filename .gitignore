# --- Offband repo additions (folded in from bootstrap) ---
# PlatformIO / Arduino build
.pio/
.pioenvs/
.piolibdeps/
*.bin
*.elf
*.map
build-logs/
debug_logs/

# Scratch firmware images built for bench/tester hand-off — not release artifacts
test-builds/

# Raw logs — captures and LLM-review transcripts stay local, off GitHub.
# NOTE: only affects NEW files. The ~30 already-tracked docs/llm-consultations/*.log
# stay tracked on purpose — PR bodies and issues cite them as review audit artifacts.
# Sibling *.md under docs/diagnostics/ are findings docs, not logs, and remain tracked.
docs/llm-consultations/*.log
docs/diagnostics/*.log

# Python bytecode (host tests + script imports under scripts/)
__pycache__/

# Per-host build secrets (WiFi/MQTT creds, OTA tokens) — never commit
platformio.local.ini
platformio.secrets.ini
.env
!.env.example
.credentials.env

# Claude Code
.claude/settings.local.json
.claude/agent-session.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# per-host device registry (LAN IPs/MACs) -- never commit; use hardware-devices.example.yaml
hardware-devices.yaml

# per-host hardware inventory / RF chain / device facts (LAN IPs, MACs, SSID, BLE PINs, GPS coords)
# -- never commit. MUST be a REAL FILE in this repo -- never a symlink, never an
# external path (#735). Public hardware facts go in HARDWARE.md instead.
HARDWARE.local.md

# Local, never committed: standards pointers and repo-local working notes.
STANDARDS.local.md
CLAUDE.local.md

# per-host flash audit log + full-flash backups (device MACs/DeviceIDs) -- never commit
flash-history.jsonl
flash-backups/

# per-host device private-key backups (exported via scripts/backup-device-key.py) -- never commit
device_backups/

# local scratch working dir -- untracked for now (#107)
weather/

# Per-session identity registry — local runtime state (standards#190/#195/#197)
.claude/sessions/

# Canonical governance artifacts — synced from DifferentWire/standards by preflight.
# Local/generated; standards is their source of truth. Do NOT track. (standards#249)
.claude/commands/bootstrap.md
.claude/commands/refresh-context.md
.claude/commands/work.md
.claude/commands/*.pre-canonical.bak
scripts/llm-consult.py
.claude/hooks/preflight.sh
.claude/hooks/pre-commit
.claude/hooks/commit-msg
.claude/hooks/post-commit
.claude/hooks/pre-push
.claude/hooks/session-state.py
.claude/hooks/resolve-active-task.py
.claude/hooks/block-direct-citadel-db.py
.claude/hooks/block-agent-mail-slug-key.py
.claude/hooks/block-primary-clone-edit.py
.claude/hooks/session-identity.py
.claude/hooks/require-checkpoint.py
.claude/hooks/checkpoint_write.py
.claude/hooks/block-skip-bypass.py
.claude/hooks/dw-approve-bypass.py

# native test-harness build leftovers (scripts/test_observer_nvs_round_trip.py et al.)
harness.obj
harness.exe

# RadioCore vendor assets (Heltec pinout artwork, vendor text, third-party
# screenshots) -- local reference only, not redistributable, ~19 MB of binaries.
# See docs/radiocore/README.md.
docs/radiocore/vendor/*
!docs/radiocore/vendor/README.md

# #740: PlatformIO-generated from sdkconfig.defaults -- build output, not source
tools/diag/rc32-boot-740/bootloader-verbose/sdkconfig.*
!tools/diag/rc32-boot-740/bootloader-verbose/sdkconfig.defaults

# Build/packaging output. Binaries belong on GitHub Releases, not in the object
# store -- git keeps every version forever and cannot delta-compress them, so
# each rebuild would add another full copy to every clone.
dist/
tools/diag/rc32-tester/firmware/

# #1629: local-reference doc artifacts. None of these are source, and all three were
# sitting untracked and re-presenting themselves as a decision on every `git status`.

# A design-handoff archive of exported mockups, ~1 MB. Same reasoning as the binaries
# above: git cannot delta-compress a zip, so every revision would be another full copy in
# every clone, forever.
docs/frontend-gui/*.zip

# Vendor material kept for reference, not for redistribution -- the same rule as the
# docs/radiocore/vendor block above, applied to the one file that sits outside it.
docs/vendor/rak13302-tx-power-extract.md

# Generated measurement output: the discharge-comparison plots and the script that draws
# them. The conclusions belong in the notes; the PNGs are reproducible from the data.
#
# Scoped to the generated artifacts rather than the whole directory ON PURPOSE. This
# directory already holds TRACKED measurement records -- rc32-battery-runtime-2026-08-18
# as .csv, .log and .md -- which are exactly what it is for. Ignoring the directory would
# not untrack those, but it WOULD silently swallow the next write-up somebody adds here:
# they would write it, `git status` would say nothing, and it would never be committed.
docs/radiocore/measurements/*.png
docs/radiocore/measurements/plot_discharge_comparison.py
